+// TestDarwinRoutingTableReadable reads this machine's real routing table the
+// way the exit-node code does, and checks it against route(8). It changes
+// nothing, so it is safe anywhere; on Mac OS X 10.9 it is the check that
+// golang.org/x/net/route parses that kernel's messages.
+func TestDarwinRoutingTableReadable(t *testing.T) {
+	if runtime.GOOS != "darwin" {
+		t.Skip("darwin routing table")
+	}
+	msgs, err := fetchRIB()
+	if err != nil {
+		t.Fatalf("fetchRIB: %v", err)
+	}
+	lo, err := net.InterfaceByName("lo0")
+	if err != nil {
+		t.Fatalf("lo0: %v", err)
+	}
+	if lr := tunRoutes(msgs, lo.Index); !lr[netip.MustParsePrefix("127.0.0.1/32")] {
+		t.Errorf("routes via lo0 = %v, want 127.0.0.1/32 among them", slices.Collect(maps.Keys(lr)))
+	}
+
+	out, err := exec.Command("route", "-n", "get", "-inet", "default").Output()
+	if err != nil {
+		t.Skipf("no IPv4 default route to compare with (route get: %v)", err)
+	}
+	var ifName, gw string
+	for _, line := range strings.Split(string(out), "\n") {
+		k, v, ok := strings.Cut(strings.TrimSpace(line), ": ")
+		switch {
+		case ok && k == "interface":
+			ifName = v
+		case ok && k == "gateway":
+			gw = v
+		}
+	}
+	if ifName == "" || gw == "" {
+		t.Skipf("route get default named no interface and gateway:\n%s", out)
+	}
+	ifi, err := net.InterfaceByName(ifName)
+	if err != nil {
+		t.Fatalf("%s: %v", ifName, err)
+	}
+	gw4, _ := defaultGateways(msgs, ifi.Index, ifName)
+	if gw4.String() != gw {
+		t.Errorf("defaultGateways(%s) = %v, want %s (route(8)'s answer)", ifName, gw4, gw)
+	}
+	if got := staleBypassRoutes(msgs, ifNameByIndex); len(got) != 0 {
+		t.Errorf("staleBypassRoutes on a table tailscaled never touched = %v, want none", got)
+	}
+}
