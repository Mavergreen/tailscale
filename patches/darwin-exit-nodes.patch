+func prefixes(ss ...string) []netip.Prefix {
+	ps := make([]netip.Prefix, len(ss))
+	for i, s := range ss {
+		ps[i] = netip.MustParsePrefix(s)
+	}
+	return ps
+}
+
+func prefixSet(ss ...string) map[netip.Prefix]bool {
+	m := make(map[netip.Prefix]bool)
+	for _, p := range prefixes(ss...) {
+		m[p] = true
+	}
+	return m
+}
+
+func TestDarwinRoutePrefixes(t *testing.T) {
+	for _, tt := range []struct {
+		in   string
+		want []netip.Prefix
+	}{
+		{"0.0.0.0/0", prefixes("0.0.0.0/1", "128.0.0.0/1")},
+		{"::/0", prefixes("::/1", "8000::/1")},
+		{"192.168.1.0/24", prefixes("192.168.1.0/25", "192.168.1.128/25")},
+		{"192.168.1.7/24", prefixes("192.168.1.0/25", "192.168.1.128/25")},
+		{"10.0.0.0/31", prefixes("10.0.0.0/32", "10.0.0.1/32")},
+		{"100.64.0.1/32", prefixes("100.64.0.1/32")},
+		{"fd7a:115c:a1e0::/48", prefixes("fd7a:115c:a1e0::/49", "fd7a:115c:a1e0:8000::/49")},
+	} {
+		if got := darwinRoutePrefixes(netip.MustParsePrefix(tt.in)); !slices.Equal(got, tt.want) {
+			t.Errorf("darwinRoutePrefixes(%s) = %v, want %v", tt.in, got, tt.want)
+		}
+	}
+}
+
+func TestDarwinExpandRoutes(t *testing.T) {
+	got := expandRoutes(prefixSet("0.0.0.0/0", "10.0.0.0/31", "10.0.0.1/32"))
+	want := prefixSet("0.0.0.0/1", "128.0.0.0/1", "10.0.0.0/32", "10.0.0.1/32")
+	if !maps.Equal(got, want) {
+		t.Errorf("expandRoutes = %v, want %v", got, want)
+	}
+}
+
+func TestDarwinDeletableRoutes(t *testing.T) {
+	old := prefixSet("0.0.0.0/1", "128.0.0.0/1", "100.100.100.100/32")
+	want := prefixSet("100.100.100.100/32")
+	viaTun := prefixSet("0.0.0.0/1", "100.100.100.100/32") // 128.0.0.0/1's add had failed
+
+	var skipped []netip.Prefix
+	got := deletableRoutes(old, want, false, viaTun, func(p netip.Prefix) { skipped = append(skipped, p) })
+	if w := prefixSet("0.0.0.0/1", "100.100.100.100/32"); !maps.Equal(got, w) {
+		t.Errorf("deletableRoutes = %v, want %v (128.0.0.0/1 is not the tunnel's to delete)", got, w)
+	}
+	if !slices.Equal(skipped, prefixes("128.0.0.0/1")) {
+		t.Errorf("skipped %v, want [128.0.0.0/1]", skipped)
+	}
+
+	got = deletableRoutes(old, want, true, prefixSet("0.0.0.0/1"), func(netip.Prefix) {})
+	if w := prefixSet("0.0.0.0/1"); !maps.Equal(got, w) {
+		t.Errorf("deletableRoutes(reset) = %v, want %v (a reset deletes every route, so holds back all not via the tunnel)", got, w)
+	}
+
+	got = deletableRoutes(old, want, true, nil, func(p netip.Prefix) { t.Errorf("skipped %v with an unreadable routing table", p) })
+	if !maps.Equal(got, old) {
+		t.Errorf("deletableRoutes(nil viaTun) = %v, want all of %v", got, old)
+	}
+}
