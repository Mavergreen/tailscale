+// osRoutePrefixes returns the prefixes to program into the OS routing table
+// so that traffic for route goes to the tunnel.
+func osRoutePrefixes(route netip.Prefix) []netip.Prefix {
+	if runtime.GOOS == "darwin" {
+		return darwinRoutePrefixes(route)
+	}
+	return []netip.Prefix{route}
+}
+
+// darwinRoutePrefixes returns the two halves of p (or p itself, if it is a
+// single address).
+//
+// The darwin kernel refuses a route whose destination and netmask match an
+// existing unscoped route, such as the default route or a LAN's connected
+// route, so installing 0.0.0.0/0 for an exit node (or a LAN prefix, to block
+// it) fails with "File exists". Each half is more specific, so the halves take
+// precedence without replacing the original route.
+func darwinRoutePrefixes(p netip.Prefix) []netip.Prefix {
+	p = p.Masked()
+	if p.IsSingleIP() {
+		return []netip.Prefix{p}
+	}
+	bits := p.Bits()
+	hi := p.Addr().AsSlice()
+	hi[bits/8] |= 0x80 >> (bits % 8)
+	hiAddr, _ := netip.AddrFromSlice(hi)
+	return []netip.Prefix{
+		netip.PrefixFrom(p.Addr(), bits+1),
+		netip.PrefixFrom(hiAddr, bits+1),
+	}
+}
+
+// routedViaTun returns the prefixes the routing table currently sends through
+// the tunnel, or nil if it can't tell.
+func (r *userspaceBSDRouter) routedViaTun() map[netip.Prefix]bool {
+	ifi, err := net.InterfaceByName(r.tunname)
+	if err != nil {
+		r.logf("routedViaTun: %v", err)
+		return nil
+	}
+	msgs, err := fetchRIB()
+	if err != nil {
+		r.logf("routedViaTun: reading routing table: %v", err)
+		return nil
+	}
+	return tunRoutes(msgs, ifi.Index)
+}
