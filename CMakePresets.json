{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "include": ["/usr/local/mavergreen-shipyard/share/cmake/MavericksShipyard/mavericks-presets.json"],
  "configurePresets": [
    {
      "name": "native",
      "inherits": "mavericks-native",
      "displayName": "native — build on Mavericks 10.9 (mavericks-golang go126 .pkg)",
      "cacheVariables": {
        "MAVERICKS_TAILSCALE_EXPECTED_MODE": "native",
        "MAVERICKS_TAILSCALE_SRC_CACHE": "$env{MAVERICKS_BUILD_ROOT}/${sourceDirName}-srccache"
      }
    },
    {
      "name": "cross",
      "inherits": "mavericks-cross",
      "displayName": "cross — build for Mavericks 10.9 on a modern host (go126-cross)",
      "cacheVariables": {
        "MAVERICKS_TAILSCALE_EXPECTED_MODE": "cross",
        "MAVERICKS_TAILSCALE_SRC_CACHE": "$env{MAVERICKS_BUILD_ROOT}/${sourceDirName}-srccache"
      }
    },
    {
      "name": "cross-legacy",
      "inherits": "mavericks-cross",
      "displayName": "cross-legacy — build for Snow Leopard 10.6 on a modern host (go126-cross + legacy106 floor)",
      "binaryDir": "$env{MAVERICKS_BUILD_ROOT}/${sourceDirName}-cross-legacy",
      "cacheVariables": {
        "MAVERICKS_TAILSCALE_EXPECTED_MODE": "cross",
        "MAVERICKS_TAILSCALE_FLOOR": "10.6",
        "MAVERICKS_TAILSCALE_SRC_CACHE": "$env{MAVERICKS_BUILD_ROOT}/${sourceDirName}-srccache"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native"
    },
    {
      "name": "cross",
      "configurePreset": "cross"
    },
    {
      "name": "cross-legacy",
      "configurePreset": "cross-legacy"
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cross",
      "configurePreset": "cross",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cross-legacy",
      "configurePreset": "cross-legacy",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
