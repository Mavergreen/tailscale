#!/bin/sh
# Activate the standalone Tailscale install. Best-effort where noted; a package-type Sparkle update
# reinstalls the whole bundle and re-runs this to reload the daemon.
mkdir -p /Library/Tailscale /Library/Logs/Tailscale 2>/dev/null || true

# Daemon (root LaunchDaemon): reload so the freshly-installed binary takes effect.
launchctl unload /Library/LaunchDaemons/dev.mavergreen.tailscaled.plist 2>/dev/null || true
launchctl load -w /Library/LaunchDaemons/dev.mavergreen.tailscaled.plist 2>/dev/null || true

# Menu-bar GUI (per-user LaunchAgent) in the console user's Aqua session (a root postinstall's own
# launchctl talks to root's session, not the user's).
CONSOLE_UID=$(stat -f %u /dev/console 2>/dev/null || echo 0)
CONSOLE_USER=$(stat -f %Su /dev/console 2>/dev/null || echo root)
if [ "${CONSOLE_UID:-0}" -gt 0 ] && [ "$CONSOLE_USER" != root ]; then
  launchctl asuser "$CONSOLE_UID" launchctl unload /Library/LaunchAgents/dev.mavergreen.tailscale-systray.plist 2>/dev/null || true
  # The old menu-bar process does NOT quit on unload's SIGTERM (its handler cleans up but never calls
  # systray.Quit()), and on 10.9 the asuser-nested unload doesn't reliably signal it anyway -- so
  # without an explicit stop, the `load -w` below starts the new instance beside the surviving old one
  # and the user sees TWO menu-bar icons. mav_stop_gui_instance (shared postinstall-stop-gui.sh, staged
  # beside this script) does the TERM-then-KILL.
  . "$(dirname "$0")/stop-gui.sh"
  mav_stop_gui_instance 'Contents/MacOS/tailscale-systray' "$CONSOLE_UID"
  launchctl asuser "$CONSOLE_UID" launchctl load -w /Library/LaunchAgents/dev.mavergreen.tailscale-systray.plist 2>/dev/null || true
fi

# Daily update-check agent: load logic rendered by mavericks-shipyard's stage_updater.sh, shipped
# beside this script as agent-load.sh (absent in a no-updater build). Sourced: no exit, MAV_-prefixed.
AGENT_LOAD="$(dirname "$0")/agent-load.sh"
[ -f "$AGENT_LOAD" ] && . "$AGENT_LOAD"

exit 0
