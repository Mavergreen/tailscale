<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.mavergreen.tailscaled</string>
  <!-- tailscaled has no native daemonize; the LaunchDaemon runs it foreground as root, RunAtLoad +
       KeepAlive. --socket is Tailscale's native darwin default (Task 0: no path patch), so the menu-bar
       GUI's default -socket agrees with zero flags; --state lives under the product's var/ (D3). A root
       tailscaled creates a real utun on 10.9 (proven on this box). -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/mavergreen/tailscale/sbin/tailscaled</string>
    <string>--state=/usr/local/mavergreen/var/tailscale/tailscaled.state</string>
    <string>--socket=/var/run/tailscaled.socket</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Library/Logs/Tailscale/tailscaled.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/Tailscale/tailscaled.log</string>
</dict>
</plist>
