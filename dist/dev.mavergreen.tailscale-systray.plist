<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.mavergreen.tailscale-systray</string>
  <!-- Per-user menu-bar GUI at login. The systray binary is LSUIElement (menu-bar only, no Dock). It
       talks to the daemon over /var/run/tailscaled.socket (its own default), so no flags are needed. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Mavericks Tailscale.app/Contents/MacOS/tailscale-systray</string>
  </array>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
